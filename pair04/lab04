numbers = [12, 3, 4, 14, -12, 5, 10, 16, -4]
positive = []
negative = []
even = []
multiples_of_3 = []

for number in numbers:
    if number > 0:
        positive.append(number)
    if number < 0:
        negative.append(number)
    if number % 2 == 0:
        even.append(number)
    if number % 3 == 0:
        multiples_of_3.append(number)

min_val = min(numbers)
max_val = max(numbers)
total_sum = sum(numbers)
average_val = total_sum / len(numbers)

print("Додатні:", positive)
print("Від’ємні:", negative)
print("Парні:", even)
print("Кратні 3:", multiples_of_3)
print(f"Min: {min_val}; Max: {max_val}; Sum: {total_sum}; Average: {average_val:.2f}")

