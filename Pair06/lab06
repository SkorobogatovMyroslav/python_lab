import math
import random
import statistics
from datetime import date
import tkinter as tk

radius = float(input("Введіть радіус круга: "))
cathetus_a = float(input("Введіть перший катет: "))
cathetus_b = float(input("Введіть другий катет: "))
items = int(input("Введіть кількість предметів: "))
capacity = int(input("Введіть місткість однієї упаковки: "))

circle_area = round(math.pi * (radius ** 2), 2)
hypotenuse = round(math.sqrt(cathetus_a ** 2 + cathetus_b ** 2), 2)
packages = math.ceil(items / capacity)

print("Площа круга:", circle_area)
print("Гіпотенуза:", hypotenuse)
print("Потрібно упаковок:", packages)

