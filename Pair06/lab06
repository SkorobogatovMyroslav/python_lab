n = int(input("Введіть кількість оцінок N: "))

if n > 0:
    grades = []
    for _ in range(n):
        grades.append(random.randint(1, 12))

    min_grade = min(grades)
    max_grade = max(grades)
    mean_grade = round(statistics.mean(grades), 2)
    median_grade = statistics.median(grades)

    high_grades_count = 0
    for grade in grades:
        if grade >= 10:
            high_grades_count += 1

    print("Оцінки:", grades)
    print("Min:", min_grade)
    print("Max:", max_grade)
    print("Середнє:", mean_grade)
    print("Медіана:", median_grade)
    print("Оцінок 10–12:", high_grades_count)
else:
    print("Помилка: кількість оцінок N повинна бути додатним числом.")

