def generate_grades(count):
    grades = []
    for _ in range(count):
        grades.append(random.randint(1, 12))
    return grades

def average_grade(grades):
    return round(statistics.mean(grades), 2)

def get_level(average):
    if average >= 10:
        return "високий"
    elif average >= 7:
        return "достатній"
    elif average >= 4:
        return "середній"
    else:
        return "початковий"

def create_report():
    value = count_entry.get().strip()

    if not value.isdecimal():
        result_text.delete("1.0", tk.END)
        result_text.insert(tk.END, "Помилка: введіть ціле число від 1 до 20.")
        return

    count = int(value)
    if count < 1 or count > 20:
        result_text.delete("1.0", tk.END)
        result_text.insert(tk.END, "Помилка: кількість оцінок має бути в межах від 1 до 20.")
        return

    students = ["Anna", "Ivan", "Olha"]
    report_lines = []

    for student in students:
        grades = generate_grades(count)
        avg = average_grade(grades)
        lvl = get_level(avg)
        report_lines.append(f"{student}: {grades} → {avg} → {lvl}")

    final_report = "\n".join(report_lines)

    print(final_report)

    result_text.delete("1.0", tk.END)
    result_text.insert(tk.END, final_report)

window = tk.Tk()
window.title("Статистика учнів")
window.geometry("520x350")

tk.Label(window, text="Введіть кількість оцінок для кожного учня (1–20):").pack(pady=5)

count_entry = tk.Entry(window, width=20)
count_entry.pack(pady=5)

tk.Button(window, text="Сформувати звіт", command=create_report).pack(pady=10)

result_text = tk.Text(window, width=60, height=10)
result_text.pack(pady=10)

window.mainloop()

