year = int(input("Введіть рік події: "))
month = int(input("Введіть місяць події: "))
day = int(input("Введіть день події: "))

event_date = date(year, month, day)
today = date.today()
difference = event_date - today

if difference.days > 0:
    print(f"До події залишилося: {difference.days} днів")
elif difference.days < 0:
    print(f"Після події минуло: {abs(difference.days)} днів")
else:
    print("Подія відбувається сьогодні!")

